# MT EPS Question Factory local settings.
# The app creates .env automatically. You can also edit these values from 05 API & Tools.

PORT=8787
FACTORY_DATA_DIR=./data

# AI provider priority: gemini-glm | glm-gemini | gemini | glm | mock
AI_PROVIDER_ORDER=gemini-glm
# Number of questions generated per AI request. 5 means roughly 8 requests for a 40Q set.
AI_BATCH_SIZE=5

# Legacy compatibility value used by older launchers.
AI_PROVIDER=mock

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GLM / OpenAI-compatible endpoint
GLM_BASE_URL=https://integrate.api.nvidia.com/v1
GLM_API_KEY=
GLM_MODEL=z-ai/glm-5.2

# Legacy OpenAI-compatible aliases
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=z-ai/glm-5.2

# Cloudflare image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# TTS_PROVIDER=local-system | openai-compatible
TTS_PROVIDER=local-system
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Optional local Whisper CLI model for YouTube/audio transcription.
WHISPER_MODEL=small
