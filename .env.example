# MT EPS Question Factory runs without API keys in mock mode.
# Copy this file to .env later when you want live AI/TTS providers.

PORT=8787
FACTORY_DATA_DIR=./data

# AI_PROVIDER=mock | gemini | openai-compatible
AI_PROVIDER=mock

# Gemini (optional, later)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible generator (optional; can point at a compatible GLM endpoint later)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# TTS_PROVIDER=local-system | openai-compatible
# local-system uses installed Windows voices and requires no API key.
TTS_PROVIDER=local-system
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# Optional local Whisper CLI model for YouTube/audio transcription.
WHISPER_MODEL=small
